# Server Configuration
PORT=5000
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=resumes

# Context.dev Web Research API
CONTEXT_API_KEY=

# Google Cloud Vertex AI Configuration
# Note: Vertex AI authenticates via Google Cloud Application Default Credentials (ADC).
# In local development: run `gcloud auth application-default login`
# In Cloud Run: uses Cloud Run Service Identity (no service-account keys needed)
GOOGLE_CLOUD_PROJECT_ID=
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-1.5-pro

# Frontend Environment Variables (for client)
VITE_API_BASE_URL=http://localhost:5000/api
