# Server
PORT=5000
NODE_ENV=development

# Frontend → Backend
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=

# Application JWT
JWT_SECRET=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=resumes

# Context.dev
CONTEXT_API_KEY=

# Google Cloud / Vertex AI
# Production uses Cloud Run Runtime Service Account; Local uses Application Default Credentials (ADC).
GOOGLE_CLOUD_PROJECT_ID=
VERTEX_AI_LOCATION=
VERTEX_AI_MODEL=

# Frontend Safe Base URL (Vite)
VITE_API_BASE_URL=http://localhost:5000
